# Local-only defaults. The server binds to loopback unless HOST is explicitly changed.
HOST=127.0.0.1
PORT=5050
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. When omitted, a 32-byte random HMAC secret is created in server/data/.hmac-secret.
# HARMONISATION_HMAC_SECRET=replace-with-at-least-32-random-bytes

# Optional persistent workspace location.
# HARMONISATION_DATA_DIR=/absolute/private/path/to/harmonisation-data
